# ─────────────────────────────────────────────────────────────
# CyberSentinel environment configuration
# Copy to .env (the setup script does this automatically).
# NEVER commit .env or real secrets.
# ─────────────────────────────────────────────────────────────

# Secret used to HMAC session tokens. Minimum 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public URL of the app (used in docs/metadata only).
APP_URL=http://localhost:3000

# Shows demo-account hints on the login screen. Set to false in production.
NEXT_PUBLIC_DEMO_MODE=true

# ── Database ──────────────────────────────────────────────────
# Leave these blank for local SQLite at data/cybersentinel.db.
# For a hosted demo, create a free Turso database and set both.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ── Optional AI provider (OpenAI-compatible) ─────────────────
# Without these, the built-in local analyst engine is used.
# Groq offers a free tier: https://console.groq.com
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# ── Demo seed accounts (development only) ────────────────────
# Change these before seeding a public demo. Minimum 12 chars.
SEED_ADMIN_EMAIL=admin@cybersentinel.dev
SEED_ADMIN_PASSWORD=DemoAdmin!2026
SEED_ANALYST_EMAIL=analyst@cybersentinel.dev
SEED_ANALYST_PASSWORD=DemoAnalyst!2026
